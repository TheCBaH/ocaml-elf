; js_of_ocaml build of the unit suites, run under node by @test-js. The sources
; are the same files `make test` runs natively.

(copy_files ../unit/test_*.ml)

(executables
 (names test_u64)
 (modes js)
 (libraries elf elf_test_support err_trace))

(rule
 (alias test-js)
 (deps test_u64.bc.js)
 (action
  (run node test_u64.bc.js)))
