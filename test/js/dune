; js_of_ocaml build of the unit suites, run under node by @test-js. The sources
; are the same files `make test` runs natively. Keep `names` in step with
; ../unit/dune; test_unix needs Unix and is native only.

(copy_files ../unit/test_*.ml)

(executables
 (names
  test_u64
  test_names
  test_codec
  test_encode
  test_decode
  test_strtab
  test_attributes
  test_malformed
  test_target
  test_exec
  test_build
  test_fuzz)
 (modules :standard \ test_unix)
 (modes js)
 (flags
  (:standard -open Elf))
 (libraries elf elf_test_support err_trace))

(rule
 (alias test-js)
 (deps
  (glob_files *.bc.js))
 (action
  (system "for f in *.bc.js; do node $f || exit 1; done")))
