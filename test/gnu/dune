; Tests that need cross binutils or QEMU. They are attached to @test-gnu and
; @test-system, never @runtest. A missing tool prints SKIP and succeeds unless
; ELF_REQUIRE_TOOLCHAIN=1.

(library
 (name elf_gnu)
 (modules
  toolchain
  readelf
  objdump
  spec
  payload
  payload_riscv
  payload_x86
  payload_arm
  payload_aarch64
  structural
  harness)
 (libraries elf elf.unix elf_test_support unix))

(executables
 (names test_objects test_isa run_user run_system)
 (modules test_objects test_isa run_user run_system)
 (libraries elf elf.unix elf_test_support elf_gnu err_trace unix))

(rule
 (alias test-gnu)
 (deps test_objects.exe test_isa.exe run_user.exe)
 (action
  (progn
   (run ./test_objects.exe)
   (run ./test_isa.exe)
   (run ./run_user.exe))))

;; System-mode tests: bare metal under qemu-system-*.

(rule
 (alias test-system)
 (deps run_system.exe)
 (action
  (run ./run_system.exe)))
