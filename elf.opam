# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Pure-OCaml ELF32/ELF64 reader and static executable writer"
description:
  "Checked ELF32/ELF64 codecs, bounded parsing, and static ET_EXEC generation for x86-32, x86-64, ARM, AArch64, RV32 and RV64. The core library depends only on the OCaml standard library and err_trace."
maintainer: ["Vladimir Silyaev"]
authors: ["Vladimir Silyaev"]
license: "MIT"
homepage: "https://github.com/TheCBaH/ocaml-elf"
bug-reports: "https://github.com/TheCBaH/ocaml-elf/issues"
depends: [
  "ocaml" {>= "4.14"}
  "dune" {>= "3.15" & >= "3.15"}
  "err_trace" {= "dev"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/TheCBaH/ocaml-elf.git"
pin-depends: [
  ["err_trace.dev" "git+https://github.com/TheCBaH/err_trace.git#v0.0.1"]
]
